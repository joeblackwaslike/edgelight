{
  "name": "@edgelite/edgelite",
  "version": "0.2.0",
  "description": "edgedb meets sqlite",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./codegen": {
      "import": "./dist/codegen/builders.js",
      "types": "./dist/codegen/builders.d.ts"
    }
  },
  "bin": {
    "edgelite": "./cli/index.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.0",
    "peggy": "^5.1.0"
  },
  "files": [
    "dist",
    "cli",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "edgedb",
    "pglite",
    "postgres",
    "query-builder",
    "schema",
    "migrations",
    "typescript"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "lint": "biome ci . && eslint . --max-warnings=0",
    "lint:fix": "biome check --write . && eslint --fix .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint",
    "depcheck": "depcheck --config=.depcheckrc.json",
    "docs:start": "docusaurus start",
    "docs:build": "docusaurus build",
    "docs:serve": "docusaurus serve",
    "docs:clear": "docusaurus clear",
    "prepare": "husky",
    "prepublishOnly": "pnpm build && pnpm typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@docusaurus/core": "^3.8.0",
    "@docusaurus/preset-classic": "^3.8.0",
    "@docusaurus/types": "^3.8.0",
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "^4.1.8",
    "depcheck": "^1.4.7",
    "docusaurus-plugin-llms": "^0.4.0",
    "docusaurus-plugin-typedoc": "^1.2.0",
    "eslint": "^10.4.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-unicorn": "^65.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "react": "^18.0.0",
    "react-dom": "^19.2.7",
    "tsx": "^4.19.2",
    "typedoc": "^0.28.19",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  },
  "author": "Joe Black <me@joeblack.nyc>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joeblackwaslike/edgelite.git"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "core-js",
      "esbuild",
      "unrs-resolver"
    ]
  },
  "packageManager": "pnpm@11.0.8",
  "lint-staged": {
    "*.{ts,js,json,md}": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ],
    "*.ts": [
      "eslint --fix --max-warnings=0 --no-warn-ignored"
    ]
  }
}
